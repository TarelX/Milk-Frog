<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MilkFrog</AssemblyName>
    <RootNamespace>MilkFrog.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.1.3</Version>
    <MilkFrogAssetRoot Condition="'$(MilkFrogAssetRoot)' == ''">$(MSBuildThisFileDirectory)..\..\assets\generated</MilkFrogAssetRoot>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\MilkFrog.Core\MilkFrog.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(MilkFrogAssetRoot)\young\animations\animations.json" LogicalName="MilkFrog.Assets/animations/animations.json" />
    <EmbeddedResource Include="$(MilkFrogAssetRoot)\young\animations\frames\**\*.png" LogicalName="MilkFrog.Assets/animations/frames/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(MilkFrogAssetRoot)\items\*.png" LogicalName="MilkFrog.Assets/items/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="MilkFrog.Assets/app.ico" />
  </ItemGroup>
  <Target Name="VerifyPrivateArtwork" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MilkFrogAssetRoot)\young\animations\animations.json')" Text="缺少私有奶蛙素材，请设置 MilkFrogAssetRoot 或把素材放到 assets/generated" />
  </Target>
</Project>
